<?xml version="1.0" encoding="UTF-8"?>
<!-- FlowMind long corridor traffic (5 junctions, 30 min). Owner: Adem.
     Same rates per junction as scenarios/corridor/corridor.rou.xml. All flows use
     probability = chance per second that a vehicle/person departs, so a different seed gives
     different traffic. The fixed events are the same in every run.
     Buses stop for passengers at the far-side stop zones of corridor5.bus.add.xml, loaded by env.py:
     at least 10 s (doors), longer while passengers board or alight (2.5 s each).
     (all entries are in time order: SUMO silently drops one that starts earlier than the one before) -->
<routes>
    <vType id="car"       vClass="passenger"/>
    <vType id="bus"       vClass="bus" length="12" maxSpeed="13.89" color="0,0.6,1" boardingDuration="2.5"/>
    <!-- Ambulance WITHOUT bluelight device: it stops at red lights like everyone else,
         so it only gets through fast if our system gives it green. -->
    <vType id="ambulance" vClass="emergency" maxSpeed="16.67" color="1,0,0"/>

    <!-- main road, both directions (~430 veh/h each) -->
    <flow id="main_we" type="car" from="W_J1" to="J5_E" begin="0" end="3600" probability="0.12" departLane="best" departSpeed="max"/>
    <flow id="main_ew" type="car" from="E_J5" to="J1_W" begin="0" end="3600" probability="0.12" departLane="best" departSpeed="max"/>

    <!-- side streets, straight across (~145 veh/h each) -->
    <flow id="side_ns1" type="car" from="N1_J1" to="J1_S1" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn1" type="car" from="S1_J1" to="J1_N1" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_ns2" type="car" from="N2_J2" to="J2_S2" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn2" type="car" from="S2_J2" to="J2_N2" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_ns3" type="car" from="N3_J3" to="J3_S3" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn3" type="car" from="S3_J3" to="J3_N3" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_ns4" type="car" from="N4_J4" to="J4_S4" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn4" type="car" from="S4_J4" to="J4_N4" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_ns5" type="car" from="N5_J5" to="J5_S5" begin="0" end="3600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn5" type="car" from="S5_J5" to="J5_N5" begin="0" end="3600" probability="0.04" departSpeed="max"/>

    <!-- turning traffic between the side streets and the main road -->
    <flow id="turn_n1_e" type="car" from="N1_J1" to="J5_E"  begin="0" end="3600" probability="0.02" departSpeed="max"/>
    <flow id="turn_w_s2" type="car" from="W_J1"  to="J2_S2" begin="0" end="3600" probability="0.02" departLane="best" departSpeed="max"/>
    <flow id="turn_s3_e" type="car" from="S3_J3" to="J5_E"  begin="0" end="3600" probability="0.02" departSpeed="max"/>
    <flow id="turn_n3_w" type="car" from="N3_J3" to="J1_W"  begin="0" end="3600" probability="0.02" departSpeed="max"/>
    <flow id="turn_e_n4" type="car" from="E_J5"  to="J4_N4" begin="0" end="3600" probability="0.02" departLane="best" departSpeed="max"/>
    <flow id="turn_s5_w" type="car" from="S5_J5" to="J1_W"  begin="0" end="3600" probability="0.02" departSpeed="max"/>

    <!-- bus line along the corridor (about one bus every 5 min per direction) -->
    <flow id="bus_we" type="bus" line="bus_we" begin="0" end="3600" probability="0.0033" departLane="best">
        <route edges="W_J1 J1_J2 J2_J3 J3_J4 J4_J5 J5_E"/><stop busStop="bs_e1" duration="10"/><stop busStop="bs_e2" duration="10"/><stop busStop="bs_e3" duration="10"/><stop busStop="bs_e4" duration="10"/>
    </flow>
    <flow id="bus_ew" type="bus" line="bus_ew" begin="0" end="3600" probability="0.0033" departLane="best">
        <route edges="E_J5 J5_J4 J4_J3 J3_J2 J2_J1 J1_W"/><stop busStop="bs_w1" duration="10"/><stop busStop="bs_w2" duration="10"/><stop busStop="bs_w3" duration="10"/><stop busStop="bs_w4" duration="10"/>
    </flow>

    <!-- bus passengers: they walk to a stop, wait for their line and ride 1-2 stops. A late bus finds
         more people waiting, boards longer (2.5 s each) and gets later: the start of bunching -->
    <personFlow id="pax_e1" begin="0" end="3600" probability="0.015"><walk from="J1_J2" busStop="bs_e1"/><ride busStop="bs_e3" lines="bus_we"/></personFlow>
    <personFlow id="pax_e2" begin="0" end="3600" probability="0.015"><walk from="J2_J3" busStop="bs_e2"/><ride busStop="bs_e4" lines="bus_we"/></personFlow>
    <personFlow id="pax_e3" begin="0" end="3600" probability="0.015"><walk from="J3_J4" busStop="bs_e3"/><ride busStop="bs_e4" lines="bus_we"/></personFlow>
    <personFlow id="pax_w1" begin="0" end="3600" probability="0.015"><walk from="J5_J4" busStop="bs_w1"/><ride busStop="bs_w3" lines="bus_ew"/></personFlow>
    <personFlow id="pax_w2" begin="0" end="3600" probability="0.015"><walk from="J4_J3" busStop="bs_w2"/><ride busStop="bs_w4" lines="bus_ew"/></personFlow>
    <personFlow id="pax_w3" begin="0" end="3600" probability="0.015"><walk from="J3_J2" busStop="bs_w3"/><ride busStop="bs_w4" lines="bus_ew"/></personFlow>

    <!-- pedestrians crossing the main road at each junction, and walking along it -->
    <personFlow id="ped_x1" begin="0" end="3600" probability="0.01"><walk from="N1_J1" to="J1_S1"/></personFlow>
    <personFlow id="ped_x2" begin="0" end="3600" probability="0.01"><walk from="S2_J2" to="J2_N2"/></personFlow>
    <personFlow id="ped_x3" begin="0" end="3600" probability="0.01"><walk from="N3_J3" to="J3_S3"/></personFlow>
    <personFlow id="ped_x4" begin="0" end="3600" probability="0.01"><walk from="S4_J4" to="J4_N4"/></personFlow>
    <personFlow id="ped_x5" begin="0" end="3600" probability="0.01"><walk from="N5_J5" to="J5_S5"/></personFlow>
    <personFlow id="ped_along" begin="0" end="3600" probability="0.01"><walk from="W_J1" to="J5_E"/></personFlow>

    <!-- first ambulance: west to east through J1 ... J5 -->
    <vehicle id="amb_1" type="ambulance" depart="120" departLane="best" departSpeed="max">
        <route edges="W_J1 J1_J2 J2_J3 J3_J4 J4_J5 J5_E"/>
    </vehicle>

    <!-- incident: an accident between J2 and J3, in the middle of the corridor. Two cars stop
         side by side and block both eastbound lanes from about t = 700 s for 300 s (5 min),
         so the queue grows back towards J2 and J1 (spillback) -->
    <vehicle id="accident_1" type="car" depart="690" departLane="1" departPos="0" color="1,0.5,0">
        <route edges="J2_J3 J3_J4 J4_J5 J5_E"/>
        <stop lane="J2_J3_1" endPos="120" duration="300"/>
    </vehicle>
    <vehicle id="accident_2" type="car" depart="690" departLane="2" departPos="0" color="1,0.5,0">
        <route edges="J2_J3 J3_J4 J4_J5 J5_E"/>
        <stop lane="J2_J3_2" endPos="120" duration="300"/>
    </vehicle>

    <!-- second ambulance: east to west through J5 ... J1 -->
    <vehicle id="amb_2" type="ambulance" depart="1100" departLane="best" departSpeed="max">
        <route edges="E_J5 J5_J4 J4_J3 J3_J2 J2_J1 J1_W"/>
    </vehicle>
</routes>
