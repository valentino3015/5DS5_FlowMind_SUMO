<?xml version="1.0" encoding="UTF-8"?>
<!-- FlowMind long corridor DEMO traffic (5 junctions, 10 min): every agent gets its moment. Owner: Adem.
     Same network and normal traffic as corridor5.rou.xml; only the events are packed into 600 s:
       t =  60 s  ambulance amb_1, west to east through J1 ... J5             -> emergency agent, green corridor
       t = 140 s  pedestrian rush at J3 (school exit, 100 s)                -> pedestrian agent and shield
       t = 230 s  accident between J2 and J3 (2 eastbound lanes, 4 min)
                  with an eastbound peak behind it                          -> incident agent, spillback to J2, J1
       t = 330 s  late bus bus_ew.1, then bus_ew.2 only 15 s behind it      -> bus agent helps the late one only
       t = 430 s  ambulance amb_2 from the east, crosses J3 and J2 while
                  the incident agent handles the accident there             -> emergency beats incident
       Buses stop for passengers (westbound line bus_ew only in the demo) at the far-side stop zones of
       corridor5.bus.add.xml, loaded by env.py: at least 10 s (doors), longer while passengers board or alight (2.5 s each).
       (all entries below are in time order: SUMO silently drops one that starts earlier than the one before) -->
<routes>
    <vType id="car"       vClass="passenger"/>
    <vType id="bus"       vClass="bus" length="12" maxSpeed="13.89" color="0,0.6,1" boardingDuration="2.5"/>
    <!-- Ambulance WITHOUT bluelight device: it stops at red lights like everyone else -->
    <vType id="ambulance" vClass="emergency" maxSpeed="16.67" color="1,0,0"/>

    <!-- normal traffic, same as corridor5.rou.xml -->
    <flow id="main_we" type="car" from="W_J1" to="J5_E" begin="0" end="600" probability="0.12" departLane="best" departSpeed="max"/>
    <flow id="main_ew" type="car" from="E_J5" to="J1_W" begin="0" end="600" probability="0.12" departLane="best" departSpeed="max"/>
    <flow id="side_ns1" type="car" from="N1_J1" to="J1_S1" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn1" type="car" from="S1_J1" to="J1_N1" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_ns2" type="car" from="N2_J2" to="J2_S2" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn2" type="car" from="S2_J2" to="J2_N2" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_ns3" type="car" from="N3_J3" to="J3_S3" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn3" type="car" from="S3_J3" to="J3_N3" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_ns4" type="car" from="N4_J4" to="J4_S4" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn4" type="car" from="S4_J4" to="J4_N4" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_ns5" type="car" from="N5_J5" to="J5_S5" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="side_sn5" type="car" from="S5_J5" to="J5_N5" begin="0" end="600" probability="0.04" departSpeed="max"/>
    <flow id="turn_n1_e" type="car" from="N1_J1" to="J5_E"  begin="0" end="600" probability="0.02" departSpeed="max"/>
    <flow id="turn_w_s2" type="car" from="W_J1"  to="J2_S2" begin="0" end="600" probability="0.02" departLane="best" departSpeed="max"/>
    <flow id="turn_s3_e" type="car" from="S3_J3" to="J5_E"  begin="0" end="600" probability="0.02" departSpeed="max"/>
    <flow id="turn_n3_w" type="car" from="N3_J3" to="J1_W"  begin="0" end="600" probability="0.02" departSpeed="max"/>
    <flow id="turn_e_n4" type="car" from="E_J5"  to="J4_N4" begin="0" end="600" probability="0.02" departLane="best" departSpeed="max"/>
    <flow id="turn_s5_w" type="car" from="S5_J5" to="J1_W"  begin="0" end="600" probability="0.02" departSpeed="max"/>

    <!-- bus passengers: they walk to a stop, wait for their line and ride 1-2 stops. A late bus finds
         more people waiting, boards longer (2.5 s each) and gets later: the start of bunching -->
    <personFlow id="pax_w1" begin="0" end="600" probability="0.015"><walk from="J5_J4" busStop="bs_w1"/><ride busStop="bs_w3" lines="bus_ew"/></personFlow>
    <personFlow id="pax_w2" begin="0" end="600" probability="0.015"><walk from="J4_J3" busStop="bs_w2"/><ride busStop="bs_w4" lines="bus_ew"/></personFlow>
    <personFlow id="pax_w3" begin="0" end="600" probability="0.015"><walk from="J3_J2" busStop="bs_w3"/><ride busStop="bs_w4" lines="bus_ew"/></personFlow>

    <!-- pedestrians, same as corridor5.rou.xml -->
    <personFlow id="ped_x1" begin="0" end="600" probability="0.01"><walk from="N1_J1" to="J1_S1"/></personFlow>
    <personFlow id="ped_x2" begin="0" end="600" probability="0.01"><walk from="S2_J2" to="J2_N2"/></personFlow>
    <personFlow id="ped_x3" begin="0" end="600" probability="0.01"><walk from="N3_J3" to="J3_S3"/></personFlow>
    <personFlow id="ped_x4" begin="0" end="600" probability="0.01"><walk from="S4_J4" to="J4_N4"/></personFlow>
    <personFlow id="ped_x5" begin="0" end="600" probability="0.01"><walk from="N5_J5" to="J5_S5"/></personFlow>
    <personFlow id="ped_along" begin="0" end="600" probability="0.01"><walk from="W_J1" to="J5_E"/></personFlow>

    <!-- fixed events, sorted by departure time -->
    <!-- first bus of the line: gives the bus agent its reference passage -->
    <vehicle id="bus_ew.0" type="bus" line="bus_ew" depart="5" departLane="best">
        <route edges="E_J5 J5_J4 J4_J3 J3_J2 J2_J1 J1_W"/><stop busStop="bs_w1" duration="10"/><stop busStop="bs_w2" duration="10"/><stop busStop="bs_w3" duration="10"/><stop busStop="bs_w4" duration="10"/>
    </vehicle>
    <vehicle id="amb_1" type="ambulance" depart="60" departLane="best" departSpeed="max">
        <route edges="W_J1 J1_J2 J2_J3 J3_J4 J4_J5 J5_E"/>
    </vehicle>
    <!-- (t = 140 s) pedestrian rush at J3 (school exit): about 30 people in 100 s -->
    <personFlow id="ped_rush" begin="140" end="240" probability="0.3"><walk from="S3_J3" to="J3_N3"/></personFlow>
    <!-- (t = 220 s) eastbound peak while the accident blocks the road, so the queue always builds up behind it -->
    <flow id="peak_we" type="car" from="W_J1" to="J5_E" begin="220" end="420" probability="0.12" departLane="best" departSpeed="max"/>
    <!-- accident: two cars stop side by side and block both eastbound lanes between J2 and J3 for 4 minutes -->
    <vehicle id="accident_1" type="car" depart="230" departLane="1" departPos="0" color="1,0.5,0">
        <route edges="J2_J3 J3_J4 J4_J5 J5_E"/>
        <stop lane="J2_J3_1" endPos="120" duration="240"/>
    </vehicle>
    <vehicle id="accident_2" type="car" depart="230" departLane="2" departPos="0" color="1,0.5,0">
        <route edges="J2_J3 J3_J4 J4_J5 J5_E"/>
        <stop lane="J2_J3_2" endPos="120" duration="240"/>
    </vehicle>
    <!-- bus_ew.1 is ~25 s late on the 300 s headway; bus_ew.2 follows only 15 s behind (bunching) -->
    <vehicle id="bus_ew.1" type="bus" line="bus_ew" depart="330" departLane="best">
        <route edges="E_J5 J5_J4 J4_J3 J3_J2 J2_J1 J1_W"/><stop busStop="bs_w1" duration="10"/><stop busStop="bs_w2" duration="10"/><stop busStop="bs_w3" duration="10"/><stop busStop="bs_w4" duration="10"/>
    </vehicle>
    <vehicle id="bus_ew.2" type="bus" line="bus_ew" depart="345" departLane="best">
        <route edges="E_J5 J5_J4 J4_J3 J3_J2 J2_J1 J1_W"/><stop busStop="bs_w1" duration="10"/><stop busStop="bs_w2" duration="10"/><stop busStop="bs_w3" duration="10"/><stop busStop="bs_w4" duration="10"/>
    </vehicle>
    <!-- second ambulance, westbound (not behind the accident): crosses J3 and J2 while the
         incident agent is handling the accident there -->
    <vehicle id="amb_2" type="ambulance" depart="430" departLane="best" departSpeed="max">
        <route edges="E_J5 J5_J4 J4_J3 J3_J2 J2_J1 J1_W"/>
    </vehicle>
</routes>
