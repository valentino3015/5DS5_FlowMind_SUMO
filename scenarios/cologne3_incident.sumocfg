<configuration>
  <!-- cologne3 + one broken-down car (see cologne3_incident.block.xml).
       Open it directly in sumo-gui to watch the blockage with SUMO's own
       traffic lights, or run scripts/demo_incident.py to see the incident
       agent react. -->
  <input>
    <net-file value="cologne3.net.xml"/>
    <route-files value="cologne3.rou.xml,cologne3_incident.block.xml"/>
  </input>
  <time>
    <begin value="25200"/>
    <end value="28800"/>
  </time>
</configuration>
